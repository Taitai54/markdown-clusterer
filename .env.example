# Optional: force both model routes local, including before first setup.
# OFFLINE_MODE=true
# Prefer Model settings in the app for persistent local configuration.

# Copy this to .env and fill in the keys for the provider(s) you use.
# Never commit your actual .env file with real API keys!

# ── Cluster naming (chat) provider ─────────────────────────────────────────
# Picks which backend names your clusters. Embeddings (below) are a separate
# setting — they drive the actual clustering, naming is just cosmetic labels.
CHAT_PROVIDER=openai            # openai | openrouter | gemini | local

# ── Embeddings provider ─────────────────────────────────────────────────────
# This is what actually groups your files — worth having a fallback if your
# OpenAI key runs out of credits. gemini and openrouter are verified working
# cloud alternates; local (Ollama) has no quota ceiling at all — needs
# `ollama pull nomic-embed-text` first (chat models like llama3.2 don't do
# embeddings).
EMBEDDING_PROVIDER=openai       # openai | gemini | openrouter | local

# openai — naming default + embeddings default
# Get a key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Embedding model choice (text-embedding-3-small/-large vs. Pinecone's
# multilingual-e5-large) is set in-app via the embedding-model dropdown,
# not here.

# openrouter — naming and/or embeddings
# Get a key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# gemini — naming and/or embeddings, via Google's OpenAI-compatible endpoint
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# (only gemini-embedding-001 works on the OpenAI-compat endpoint — text-embedding-004 404s there)

# local — naming and/or embeddings, via any OpenAI-compatible local server (default: Ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_CHAT_MODEL must exactly match an installed tag — check with `ollama list`
OLLAMA_CHAT_MODEL=llama3.2:latest
# OLLAMA_EMBEDDING_MODEL must be a dedicated embedding model, not a chat model
# — `ollama pull nomic-embed-text` (or mxbai-embed-large, etc.) first
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# If you select multilingual-e5-large from the in-app embedding-model dropdown,
# a Pinecone key is required when EMBEDDING_PROVIDER=openai — either pasted
# into the app's API key modal, or set here:
PINECONE_API_KEY=

# ── Application Settings ────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
